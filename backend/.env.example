MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=reframe
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
JWT_SECRET=change-me

# Local free room redesign (no paid image API keys required)
IMAGE_PROVIDER=local
LOCAL_MODEL_ID=segmind/tiny-sd
# Inpainting model (used when user provides edit masks)
LOCAL_INPAINTING_MODEL_ID=runwayml/stable-diffusion-inpainting
# auto | preview | balanced | quality  (aliases: low_memory, high)
LOCAL_AI_PROFILE=auto
LOCAL_MAX_RETRIES=2

# Optional chat only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
